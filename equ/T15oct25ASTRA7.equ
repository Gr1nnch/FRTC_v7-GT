!DELVAR = 1.01;

TAUMAX = 1.e-4;

TAUMIN=1.d-5;

DPOUT=1.d-4;  

DROUT=1.d-4;

DTOUT=0.0001;

TSTART = 0.11;

TEND = 0.305;

TINIT=0.299;

TSCALE = 0.006;

TPAUSE = 0.315;

!neoclassical module
NEOCL(100)<:;

!!=========Equilibrium solver=========
NBND = 100;
NEQUIL =  41;
MEQUIL =  41;

DTEQL  =  0.000E+00
ADCMPF =  2.000E+00
ITFBE  =  -1
ICIRCQ =  0.
IPCTRL =  0.
SGNIP  =  +1.00E+00
SGNBT  =  +1.00E+00

!!=========DENSITY============

!==========NEUT============

!high NNCL=0.055;
!low  NNCL=0.00055;
SN=SNNEU*NE+SNEBM;  

!!-------------Electron density-------------
NE:AS;
NE=NEX;

!!==========Ion density=================
ZEF = 1.6;

ZIM1=ZICAR; 
AIM1=12.0;
NIZ1=NE*(ZEF-ZMJ)/(ZIM1-ZMJ)/ZIM1;
NIZ2=0.0;

NI=NE*(ZIM1-ZEF+1.)/ZIM1;	!density of all ions

!NHYDR=(NI-NIZ1)*0.42; !42119
NHYDR=(NI-NIZ1)*0.167; !42777

NDEUT=NI-NIZ1-NHYDR;
				!density of deuterium plasma ions
AMAIN=1.8;			!mass of main ion component
ZMAIN=1;			!charge of main ion component

!!=========TEMPERATURE============

!!-------------Electron temparature-------------
TE:As;
TE=TEX;

!!-------------Ion temparature-------------
TI:As;
TI = TIX;

!TI:Eq;
!TI = TIX;
!TIB = 0.03;

!42777 high
!XI="work(j,165)";

!42777 low
XI=1.7; "work(j,165)"*2.1;


PE=PJOUL-PEIZZ+CAR1X;
PI=CAR2X+PEIZZ+PINEU;



!===========Dynamic FRTC===========


QLH=4.0d0;

!QLH=0.5d0;

CF1=0.1d-3;  !interval between lhcd() calls, sec

CF2=0.3d0;  !first call of lhcd()

CF3=0.61d0;

DSTART=CF2-0.005;

debug:0.0001:DSTART::;

saveprofiles::CF2:CF3:;

lhcd2017(PELH,CAR14,CAR15,ZRD8):CF1:CF2:CF3:;

drivencurrent(CULH,ZRD35,ZRD36,CAR12,CAR13,CAR32)::CF2:CF3:;



!!=========NBI=========
!NBI::1e-3::;

CNB1=2;
CNB2=1;
CNB3=0.1;
CNB4=1;
CNBI1=1;
CNBI2=1.0;
CNBI3=0.1;
CNBI4=0.1;  

!!========Current Density===========
CU:Eq;
!CU=FPR;
CU=CUX;
CC="work(j,303)";
CUBS="work(j,301)";
!CD=CUBM*0.5;





!!========ROTATION===================== 
VTOR=VTORX;
VPOL="work(j,170)"; 
ER=BTOR*(FRS*MU*VTOR/RTOR+VDIA-VPOL);    !Radial electric field


!====================   Radial output  =================================

J\CU\-2;       Plh\PELH;   Johm\CUOHM\-2;   E\UPL/(RTOR+AMETR)/GP2;

Te\TE\\TEX;   Plh2\PELH\-2;   CC\CC\-3;      Q\1./MU;

Jlh\CULH\-2;   Upl\UPL;    cSp\CAR24\-2;     Poh\POH\-2;

Ti\TI\\TIX;      Ne\NE\\NEX;    sig\CAR32\-3;     Zef\ZEF\-1;


!====================  Time output  ===================================


L_LINTB_3;

IPL_IPL_-21;

Qpr_ZRD8_-1;

QLh_QLH_0.15;

Vexp_ZRD1_2;

Iohm_IOHMB_-10;

V_UPLB_2; 

ICD_ILHB_-21;

ICCH_ZRD5_-10; 

IBS_IBSB_-21;








