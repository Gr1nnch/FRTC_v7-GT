
!----------------- Times -----------------
TSTART = 0.011d0;
TEND = 0.03250;
TINIT = 0.02d0;
!TPAUSE = 0.03d0;
TSCALE = 0.015d0;
TAUMAX = 1.e-4;
TAUMIN=1.d-5;
DROUT = 1.d-4;
DPOUT = 1.d-4;
DTOUT = 1.d-5;
DSTART = 0.026d0;

NEOCL(100)<:;

CF1 = 0.1d-3;
CF2 = 0.028d0;
CF3 = 0.040d0;
!----------------- Electrons parametrs -----------------
CF14 = 1.5d0;

NE:AS;
CF10 = 1.5d0*(1.d0+0.5d0*FRAMP(CF2,CF3));
CF11 = 0.15d0;
!NE = (CF10-CF11)*FPA**CF14+CF11;
!NE = (CF10+CF11)*EXP(-(CF14+0.4)*(RHO/ROC)**2);
NE = NEX;
!NE=(2.2-0.22)*((1-(AMETR/ABC)**2)**1)+0.22;

TE:AS;
CF12 = 468.0d-3 - 88.0d-3*FRAMP(CF2,CF3);
CF13 = 30.0d-3 - 7.0d-3*FRAMP(CF2,CF3);
!TE = (CF12-CF13)*FPA**CF14+CF13;
!TE = (CF12+CF13 + 0.13*FRAMP(0.030,CF3))*EXP(-(CF14+0.4)*(RHO/ROC)**2);
TE = TEX;
!TE=((0.6-0.06)*((1-(AMETR/ABC)**3)**2)+0.06)*1.2;
!----------------- Ion parametrs -----------------

TI:AS;

!TI = 0.16*(1.d0+0.1d0*FRAMP(0.026,0.034))*FPR**CF14+CF13;
!TI = 0.265*(1.d0+0.1d0*FRAMP(CF2,CF3))*EXP(-(CF14+0.4)*(RHO/ROC)**2);
TI = TIX/1000;
!TI=(0.130-0.013)*((1-(AMETR/ABC)**2)**1.5)+0.013;

!----------------- Impurities -----------------

AMAIN = AMJ;
ZMAIN = ZMJ;

!Carbon 

AIM1 = 16;
ZIM1 = 8;

ZEF = 3.5d0

!Its densities

NIZ1 = NE*(ZEF-ZMJ)/(ZIM1-ZMJ)/ZIM1;
NI = NE*(ZIM1-ZEF)/(ZIM1-ZMJ)/ZMJ;

!----------------- Plasma parametrs -----------------
!Current densities

CU:EQ;
CU = CUX;
CUBS="work(j,301)";

CAR31 = CNHR + CCMHD;
CC = CAR31;

!----------------- Equilibrium solver -----------------

NEQUIL = 41;

!----------------- LHCD & DrivenCurrent -----------------

QLH = 0.2d0;

debug:0.0001:DSTART::;
saveprofiles::CF2:CF3:;
lhcd2017(PELH):CF1:CF2:CF3:;
drivencurrent(CULH,CAR32,CU)::CF2:CF3:;

CD = CULH;
CCD1 = VINT(PELHB);
CCD2 = IINT(CULHB);

!====================   Radial output  =================================
J\CU\-1;       Plh\PELH;   Johm\CUOHM\8;   E\UPL/(RTOR+AMETR)/GP2;
Te\TE\\TEX;	Plh2\PELH\-2;   CC\CC\-3;      Q\1./MU;
Jlh\CULH\-1;   Upl\UPL;    Zef\ZEF\-1;     Poh\POH\-2;
Ti\TI\\TIX;      Ne\NE\\NEX;    sig\CAR32\-3;    Chr\CAR31; 
  


!====================  Time output  ===================================
L_LINTB_3;
IPL_IPL_-21;
Qpr_ZRD8_-1;
QLh_QLH_0.15;
Vexp_ZRD1_2;
Iohm_IOHMB_-10;
V_UPLB_2; 
ICD_ILHB_-21;
ICDP_ZRD35_2; 
IBS_IBSB_-21;











